# Copy to .env (untracked) and fill in. Never commit .env.
WAF_DB_PASSWORD=
NETSCALER_HOST=
NETSCALER_USERNAME=
# Writes to the ADC are OFF unless you set this to true deliberately.
NETSCALER_WRITE_ENABLED=false
# Keep true; provide secrets/netscaler_known_hosts (ssh-keyscan output verified out of band).
NETSCALER_SSH_STRICT_HOST_KEY=true
